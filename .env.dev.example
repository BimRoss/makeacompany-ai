# Copy to `.env.dev` (gitignored). Used by `../agents-mcp-server/docker-compose.yml` (profile local).
# Full field list and prod notes: see `.env.example` in this repo.

APP_ENV=development
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:8091

BACKEND_INTERNAL_SERVICE_TOKEN=mac-local-dev-internal-service-token
REDIS_URL=redis://localhost:6380/0

ADMIN_SIGN_IN_ALLOWLIST=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASE_PLAN=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PORTAL_GOOGLE_OAUTH_STATE_SECRET=

RESEND_API_KEY=
PORTAL_AUTH_EMAIL_FROM=
RESEND_MAGIC_LINK_TEMPLATE_ID=
RESEND_CHECKOUT_WELCOME_TEMPLATE_ID=

# Joanne Google Docs / Gmail for MCP `create_google_doc` live in `skills-mcp-server/.env.dev` (JOANNE_GOOGLE_*), not here.

ORCHESTRATOR_SLACK_BOT_TOKEN=

# Optional local compose convenience (see agents-mcp-server compose header)
NEXT_PUBLIC_LOCAL_DOCKER_AUTO_HUMANS_WELCOME_EMAIL=

# Kube port-forward helpers (host tooling only; not required for agents-mcp-server compose)
KUBECONFIG_HOST_PATH=
KUBECONFIG_CONTEXT=admin
