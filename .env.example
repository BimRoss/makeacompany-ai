# Environment files (gitignored): `.env.dev` (local / test) and `.env.prod` (production cluster sync).
# Copy this file to both and fill in real values.
#
# Docker Compose loads secrets into containers from `${MAKEACOMPANY_AI_ENV_FILE:-.env.dev}` (override with
# `MAKEACOMPANY_AI_ENV_FILE=.env.prod` when you want prod keys in compose).
#
# Host `go run` / `npm run dev` often read only `./.env`: run `./scripts/use-env.sh dev|prod` → symlink `.env` → `.env.dev|.env.prod`.
# Prod secrets: keep live keys only in `.env.prod`; run `./scripts/update-rancher-secrets.sh`
# (uses `.env.prod` when `ENV_FILE` is unset). Never use `.env.dev` for that script.

# Optional prod-like compose: `npm run docker:prod -- up --build` loads .env.prod for compose interpolation
# (KUBECONFIG_*) and frontend-prod defaults to .env.prod when MAKEACOMPANY_AI_ENV_FILE is unset.

# Local / compose
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Runtime environment marker (production may enable stricter defaults in some stacks).
# APP_ENV=development
# Browser → makeacompany API. For `docker compose --profile local`, compose sets COMPOSE_PUBLIC_API_URL (default :8090).
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:8090
# Optional — only needed for npm run dev on host without compose; in compose, docker-compose sets http://backend:8080
# BACKEND_INTERNAL_API_BASE_URL=http://localhost:8090
# Go backend: optional Bearer for /v1/internal/* maintenance endpoints (Kubernetes CronJobs).
# If unset locally, POST /v1/internal/refresh-* still works when called with the same Authorization Bearer as
# `/admin` (your mac_admin_session token).
# Local docker compose defaults this to mac-local-dev-internal-service-token when unset.
BACKEND_INTERNAL_SERVICE_TOKEN=mac-local-dev-internal-service-token
# Compose prod profile (frontend + in-compose kubectl port-forwards to admin cluster services)
# Optional — compose defaults to ${HOME}/.kube/config/admin.yaml when unset (matches BimRoss layout).
KUBECONFIG_HOST_PATH=${HOME}/.kube/config/admin.yaml
KUBECONFIG_CONTEXT=admin
PROD_BACKEND_PORT=18080
# Optional — LinkedIn Insight Tag partner id (enabled in production only)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Redis — host `go run` / tests: use the same host port as compose publishes (default 6380).
# Keep REDIS_URL defined in both .env.dev and .env.prod — waitlist, admin/portal sessions, and admin snapshots rely on it.
REDIS_URL=redis://localhost:6380/0

# Admin sign-in allowlist (comma-separated, required for /admin auth to be enabled).
# Production: operator emails (see rancher-admin makeacompany-ai ConfigMap).
ADMIN_SIGN_IN_ALLOWLIST=grant@bimross.com,grantdfoster@gmail.com
# Session lifetime in seconds:
ADMIN_SESSION_TTL_SEC=259200
# Temporary prod diagnostics: when set to 1 on the Next.js server, GET /api/admin/auth/debug returns cookie
# presence (not the value) and the HTTP status from proxying to Go GET /v1/admin/auth/me. Remove after investigation.
# ADMIN_AUTH_DEBUG=1

# Stripe — one set per file (.env.dev = test, .env.prod = live).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Homepage checkout: Stripe Dashboard product "Base Plan" → default recurring price_* id ($99/mo).
STRIPE_PRICE_ID_BASE_PLAN=price_...
# Optional: one-time waitlist / deposit price_* (shows in admin Stripe table next to base plan). Omit if you only sell monthly.
# STRIPE_PRICE_ID_WAITLIST_DEPOSIT=price_...
# Deprecated: read only if STRIPE_PRICE_ID_BASE_PLAN is unset (remove after rotating all env files / cluster secrets).
# STRIPE_PRICE_ID_WAITLIST=price_...
# Free tier gate: set to true to block free users from deploying after their first ship (Joanne enforces via /v1/portal/deploy-gate).
# Keep unset / false until Joanne-side enforcement is live (makeacompany-ai#112).
# STRIPE_FREE_TIER_GATE_ENABLED=true

# Portal login (`/{channelId}/login` and `/admin/login`) — Google OAuth (Next exchanges code; Go validates `id_token`).
# Authorized redirect URI in Google Cloud Console: `{APP_BASE_URL}/api/portal/auth/google/callback` (admin Google sign-in uses the same callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: HMAC secret for OAuth `state` (min 16 chars). If unset, `GOOGLE_OAUTH_CLIENT_SECRET` is used.
# PORTAL_GOOGLE_OAUTH_STATE_SECRET=

# Google Analytics 4 summary panel on /admin (last 7d activeUsers + sessions).
# GA4_PROPERTY_ID is the numeric property id (e.g. 527260023 for makeacompany.ai).
# GOOGLE_APPLICATION_CREDENTIALS must point to a service-account key whose
# principal is bound as Viewer on the GA4 property — the GA4 UI hard-blocks SA
# emails, so use the Analytics Admin API v1alpha accessBindings POST instead
# (recipe: scope=analytics.manage.users, project-owned OAuth client, see
# ~/.claude memory ga4-add-service-account). When GA4_PROPERTY_ID is unset,
# /v1/admin/ga4-summary returns 503 and the panel is hidden.
# TODO(prod): wire the SA key as a rancher-admin Secret + mount it on the
# backend Deployment, then set both vars in .env.prod.
# GA4_PROPERTY_ID=527260023
# GOOGLE_APPLICATION_CREDENTIALS=/var/run/secrets/ga4/key.json

# Magic sign-in links + post-checkout welcome invites (optional): Resend transactional email;
# `from` must be a verified sender/domain in Resend.
RESEND_API_KEY=
PORTAL_AUTH_EMAIL_FROM=
# Optional: published Resend template id or slug (e.g. account-login). If empty, Go uses simple inline HTML/text.
RESEND_MAGIC_LINK_TEMPLATE_ID=
# Optional: variable names in your template (defaults match account-login-style templates).
# RESEND_MAGIC_LINK_TEMPLATE_LINK_VAR=login_url
# RESEND_MAGIC_LINK_TEMPLATE_FIRST_NAME_VAR=recipient_first_name
# Optional: Resend template for post-Stripe-checkout welcome (e.g. welcome-email). Button URL uses login_url (Slack invite).
# Also sends joanne_headshot_url (APP_BASE_URL + /headshots/joanne.png) — use in the template for an <img> next to the signature.
# RESEND_CHECKOUT_WELCOME_TEMPLATE_ID=welcome-email

# Admin Slack-author headshots (welcome toast): map Slack **bot user IDs** to employee headshots + names.
# Optional one-line form (employee slug → U…):
# MULTIAGENT_BOT_USER_IDS=ross:U0APX108QE7,joanne:U0AQL5WF8RK
# Per-bot overrides (win over the line above for that employee if set):
# ROSS_SLACK_BOT_ID=U0APX108QE7
# JOANNE_SLACK_BOT_ID=U0AQL5WF8RK

# Observability: `/admin` overview grid (6 panels on MakeACompany Observability dashboard).
# Optional origin-only URL when browsing localhost (avoids pasting full dashboard URL). Example: kubectl
# port-forward -n makeacompany-ai svc/makeacompany-ai-grafana 13000:3000 → set HEALTH_GRAFANA_LOCAL_BASE_URL=http://127.0.0.1:13000
# docker compose --profile prod sets this automatically to match PROD_GRAFANA_HOST_PORT (see docker-compose.yml).
HEALTH_GRAFANA_LOCAL_BASE_URL=
HEALTH_GRAFANA_DASHBOARD_URL=
HEALTH_GRAFANA_ADMIN_PANEL_IDS=1,2,3,4,9,8
HEALTH_GRAFANA_ADMIN_PANEL_TITLES=Requests /min,P95 latency,Inbound events by agent,Activities,JetStream publish /s,Backend HTTP errors/min

# `/admin` — Kubernetes CronJob / Job panels (default dashboard path: /grafana/d/makeacompany-cronjobs/makeacompany-cronjobs).
HEALTH_GRAFANA_CRON_DASHBOARD_URL=
HEALTH_GRAFANA_CRON_PANEL_IDS=1,2,3
HEALTH_GRAFANA_CRON_PANEL_TITLES=CronJob — last schedule / next run,Job success vs failure (by CronJob),Job or pod run duration

# `/twitter` Grafana embeds only (MakeACompany Twitter Health dashboard)
HEALTH_GRAFANA_TWITTER_DASHBOARD_URL=
HEALTH_GRAFANA_TWITTER_PANEL_IDS=1,3
HEALTH_GRAFANA_TWITTER_PANEL_TITLES=Indexer throughput,Worker throughput

# Health stack (indexer + cookie health)
HEALTH_PROMETHEUS_URL=
HEALTH_GRAFANA_URL=
HEALTH_TWITTER_INDEXER_URL=
HEALTH_TWITTER_WORKER_URLS=
HEALTH_COOKIE_STALE_AFTER_MINUTES=180
